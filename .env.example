# Export these in the process environment. No dotenv loader is used.
ENGINE_DATABASE_URL=postgres://localhost/suncharts_engine_dev
# Containers may set ENGINE_DATABASE_URL_FILE instead. Never set both forms.
ENGINE_BIND=127.0.0.1:8090
# Disabled by default. Only enable for the old trusted gateway development path.
ENGINE_ALLOW_LEGACY_GATEWAY=false
# Generate a dedicated random secret with openssl rand -hex 32; do not reuse app JWT secrets.
ENGINE_JWT_SECRET=
# Containers may set ENGINE_JWT_SECRET_FILE instead. Never set both forms.
ENGINE_TOKEN_ISSUER=suncharts
ENGINE_TOKEN_AUDIENCE=suncharts-engine


# Standalone web GUI. Dedicated synthetic development identity; never commit real values.
ENGINE_PUBLIC_URL=http://127.0.0.1:8090
# Controls visible environment labeling. Managed production installations set production.
ENGINE_ENVIRONMENT=development
ENGINE_BOOTSTRAP_EMAIL=
ENGINE_BOOTSTRAP_PASSWORD=
# Containers may set ENGINE_BOOTSTRAP_PASSWORD_FILE instead. Never set both forms.
ENGINE_BOOTSTRAP_TENANT_ID=
ENGINE_BOOTSTRAP_CLINICIAN_ID=

# New accounts only: owner (default) or clinician. Does not alter existing users.
ENGINE_BOOTSTRAP_ROLE=owner

# Managed hosted instances only. Connect mounts this order-bound capability envelope as a Secret.
# Never pass it in a URL, browser request, log line, or container image.
# ENGINE_MANAGED_CONNECT_BOOTSTRAP_FILE=/run/secrets/managed-connect/managed_connect_bootstrap.json
# ENGINE_DEPLOYED_IMAGE_REFERENCE=ghcr.io/pindustries/suncharts-ehr@sha256:<64-lowercase-hex>
# ENGINE_DEPLOYED_VERSION=<selected immutable release version>

# Optional operator-managed HTTPS gateway routes; no destination configured by default.
# See docs/clearinghouses.md. Config references credential env names only.
# ENGINE_CLEARINGHOUSE_CONFIG=/private/suncharts/clearinghouse-routes.json
# ENGINE_CLEARINGHOUSE_TOKEN_ENROLLED=
# Provider routes: stedi / claim_md / office_ally_sftp / availity_sftp.
# See docs/clearinghouses.md. Provision one account/mailbox per tenant route.
# ENGINE_CLEARINGHOUSE_TOKEN_STEDI=
# ENGINE_CLEARINGHOUSE_TOKEN_CLAIMMD=
# ENGINE_CLEARINGHOUSE_SFTP_OFFICEALLY_USER=
# ENGINE_CLEARINGHOUSE_SFTP_OFFICEALLY_KEY_FILE=/private/suncharts/officeally_ed25519
# ENGINE_CLEARINGHOUSE_SFTP_OFFICEALLY_KNOWN_HOSTS_FILE=/private/suncharts/known_hosts

# Native clearinghouse settings store encrypted AccountKeys in PostgreSQL.
# The server creates a private 32-byte master key at this persistent path.
# Keep and back up this key separately from the database. Containers must mount
# a persistent private volume here; ephemeral container storage is insufficient.
# ENGINE_CREDENTIAL_KEY_FILE=/private/suncharts/provider-master.key

# External referral receiving gateways; exact HTTPS hostnames on port 443.
# Configure the destination and bearer credential through Referral delivery settings.
# ENGINE_REFERRAL_ALLOWED_HOSTS=referrals.example.org
# Local synthetic receiver testing only; requires a loopback HTTP EHR origin.
# ENGINE_REFERRAL_ALLOW_LOOPBACK=false

# Connect uses the official SunCharts HTTPS service by default. No inbound port is needed.
# Explicit loopback-only synthetic integration testing (never production):
# ENGINE_CONNECT_CLOUD_URL=http://127.0.0.1:8080
# ENGINE_CONNECT_ALLOW_LOOPBACK=false
# ENGINE_CONNECT_ALLOW_DEVELOPMENT=false  # exact https://dev.suncharts.app only

# Live appointment copays only; default off. Requires Connect live Checkout gate
# plus verified live account readiness. Test-mode activity is always blocked in production.
# ENGINE_HOSTED_COPAY_LIVE_ENABLED=false

# Optional self-hosted ONLYOFFICE Docs (DOCX/XLSX; no transfer until explicit Open).
# Configure the same JWT secret on the document server. This file must be private (0600),
# contain at least 32 characters, and must never be committed.
# ENGINE_OFFICE_ORIGIN=https://office.example.test
# ENGINE_OFFICE_JWT_SECRET_FILE=/private/suncharts/office-jwt
# Callback origin normally equals the configured EHR browser origin.
# ENGINE_OFFICE_CALLBACK_ORIGIN=https://ehr.example.test
# Disposable local development only; permits loopback HTTP and host.docker.internal
# callback on the EHR port. Ignored when ENGINE_ENVIRONMENT=production.
# ENGINE_OFFICE_ALLOW_LOCAL_TEST=true
