{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suncharts.app/schemas/ehr-installation-release-state-v1.json",
  "title": "SunCharts EHR installation release state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "installation_id", "policy", "current", "desired", "last_known_good", "update"],
  "properties": {
    "contract_version": {"const": "1"},
    "installation_id": {"type": "string", "format": "uuid"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["stable", "preview", "pinned"]},
        "pinned_version": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"},
        "scheduled_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "pinned"}}}, "then": {"required": ["pinned_version"]}},
        {"if": {"properties": {"mode": {"enum": ["stable", "preview"]}}}, "then": {"not": {"required": ["pinned_version"]}}}
      ]
    },
    "current": {"$ref": "#/$defs/release"},
    "desired": {"$ref": "#/$defs/release"},
    "last_known_good": {"$ref": "#/$defs/release"},
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempt_id"],
      "properties": {
        "status": {"enum": ["idle", "scheduled", "backing_up", "deploying", "health_gating", "ready", "rollback_pending", "rolling_back", "failed"]},
        "attempt_id": {"type": ["string", "null"], "format": "uuid"},
        "backup_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "pre_update_schema_revision": {"type": ["integer", "null"], "minimum": 0},
        "health_deadline": {"type": ["string", "null"], "format": "date-time"},
        "failure_code": {"type": ["string", "null"], "pattern": "^[a-z0-9_]{1,64}$"}
      }
    }
  },
  "$defs": {
    "release": {
      "type": ["object", "null"],
      "required": ["version", "image_reference", "schema_revision"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"},
        "image_reference": {"type": "string", "pattern": "^ghcr\\.io/pindustries/suncharts-ehr@sha256:[0-9a-f]{64}$"},
        "schema_revision": {"type": "integer", "minimum": 0}
      }
    }
  }
}
