{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suncharts.app/schemas/ehr-dev-preview-manifest-v1.json",
  "title": "SunCharts EHR dev preview manifest v1 (never production eligible)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "version", "image_reference", "channel_eligibility", "production_eligible", "preview", "source", "build", "database", "attestation"],
  "properties": {
    "contract_version": {"const": "dev-preview-1"},
    "version": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"},
    "image_reference": {"type": "string", "pattern": "^ghcr\\.io/pindustries/suncharts-ehr@sha256:[0-9a-f]{64}$"},
    "channel_eligibility": {"const": ["dev"]},
    "production_eligible": {"const": false},
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "release", "full_regression"],
      "properties": {
        "build_id": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*\\+dev\\.[0-9a-f]{12}$"},
        "release": {"type": "string", "pattern": "^dev-[0-9a-f]{12}$"},
        "full_regression": {"const": "not_required"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "branch"],
      "properties": {
        "repository": {"const": "PIndustries/suncharts-ehr"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"const": "main"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust_image", "runtime_image", "debian_snapshot"],
      "properties": {
        "rust_image": {"type": "string", "pattern": "^rust:1\\.89-bookworm@sha256:[0-9a-f]{64}$"},
        "runtime_image": {"type": "string", "pattern": "^debian:bookworm-slim@sha256:[0-9a-f]{64}$"},
        "debian_snapshot": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_revision", "minimum_upgrade_schema_revision", "rollback_mode"],
      "properties": {
        "schema_revision": {"type": "integer", "minimum": 0},
        "minimum_upgrade_schema_revision": {"type": "integer", "minimum": 0},
        "rollback_mode": {"enum": ["same_schema_image_only", "restore_pre_update_backup"]}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "workflow_ref"],
      "properties": {
        "issuer": {"const": "https://token.actions.githubusercontent.com"},
        "workflow_ref": {"const": "PIndustries/suncharts-ehr/.github/workflows/publish-dev-preview.yml@refs/heads/main"}
      }
    }
  }
}
